<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT">
      <PatternLayout pattern="[%-5p] %m%n" />
    </Console>
  </Appenders>
  <Loggers>
    <Root level="all">
      <AppenderRef ref="STDOUT" level="WARN"/>
    </Root>
  </Loggers>
</Configuration>